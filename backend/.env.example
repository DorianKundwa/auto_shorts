# Google Gemini (Primary Multi-Modal Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Optional Alternative Providers
OPENAI_API_KEY=your_openai_or_groq_key_here
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=http://localhost:11434

# YouTube Data API v3 & OAuth 2.0 (For 1-Click Shorts Publishing)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID (Web application)
# Authorized Redirect URI: http://localhost:8000/api/youtube/callback
YOUTUBE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/callback

